

# Backend
UVICORN_RELOAD=true
UVICORN_WORKERS_COUNT=4
CORS_ORIGINS='["http://localhost", "http://127.0.0.1", "http://localhost:5000", "http://127.0.0.1:5000", "http://localhost:8000", "http://127.0.0.1:8000"]'

# Jwt
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=super_secret_key
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=2

# Passwords
PASSWORD_SALT=super_secret_key

# Postgres
POSTGRES_DB_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET=audios
MINIO_SECURE=false
MINIO_REGION=us-east-1
